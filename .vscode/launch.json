{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug File Hiện Tại",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Debug Test Mở Rương",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tools/test_mo_ruong.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Debug GUI Auto Config",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/gui_auto_config.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}